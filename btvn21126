<?php

class ImageUpload
{
    private array $file;
    private string $uploadDir;

    public function __construct(array $file, string $uploadDir = 'uploads/')
    {
        $this->file = $file;
        $this->uploadDir = rtrim($uploadDir, '/\\') . DIRECTORY_SEPARATOR;
    }

    // Lấy tên file gốc
    public function getFileName(): string
    {
        return basename($this->file['name']);
    }

    // Kiểm tra file có phải ảnh jpeg, jpg, png hoặc gif không
    public function validateFile(): string
    {
        if ($this->file['error'] !== UPLOAD_ERR_OK) {
            return 'Không thể tải file lên. Vui lòng thử lại.';
        }

        $extension = strtolower(pathinfo($this->getFileName(), PATHINFO_EXTENSION));

        $allowedTypes = [
            'jpg'  => 'image/jpeg',
            'jpeg' => 'image/jpeg',
            'png'  => 'image/png',
            'gif'  => 'image/gif',
        ];

        if (!isset($allowedTypes[$extension])) {
            return 'Chỉ cho phép file JPEG, JPG, PNG hoặc GIF.';
        }

        // Kiểm tra nội dung thực tế, không chỉ dựa vào phần mở rộng
        $imageInfo = @getimagesize($this->file['tmp_name']);

        if ($imageInfo === false || $imageInfo['mime'] !== $allowedTypes[$extension]) {
            return 'File không phải là ảnh hợp lệ.';
        }

        return '';
    }

    // Di chuyển file vào thư mục lưu trữ
    public function moveFile(): string
    {
        $error = $this->validateFile();

        if ($error !== '') {
            return $error;
        }

        if (!is_dir($this->uploadDir)) {
            if (!mkdir($this->uploadDir, 0755, true)) {
                return 'Không thể tạo thư mục lưu ảnh.';
            }
        }

        $extension = strtolower(pathinfo($this->getFileName(), PATHINFO_EXTENSION));

        // Tạo tên mới để tránh trùng tên và ghi đè file
        $newName = bin2hex(random_bytes(16)) . '.' . $extension;
        $destination = $this->uploadDir . $newName;

        if (move_uploaded_file($this->file['tmp_name'], $destination)) {
            return 'Tải lên thành công! Tên file gốc: ' . $this->getFileName();
        }

        return 'Không thể di chuyển file vào thư mục lưu trữ.';
    }
}

$message = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    if (isset($_FILES['image'])) {
        $imageUpload = new ImageUpload($_FILES['image']);
        $message = $imageUpload->moveFile();
    } else {
        $message = 'Vui lòng chọn một file ảnh.';
    }
}
?>

